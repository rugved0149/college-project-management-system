PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-24-characters
DB_PATH=./storage/college_projects.db

# Supabase PostgreSQL and private object storage (required after the migration is complete)
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
PGSSLMODE=require
PG_POOL_MAX=5
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=submissions
INITIAL_ADMIN_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.edu
INITIAL_ADMIN_PASSWORD=ChangeThisPassword123!

UPLOAD_DIR=./storage/uploads

# Brevo transactional email settings
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=CampusFlow
APP_URL=http://localhost:5173

# Optional ClamAV daemon for malware scanning
CLAMAV_HOST=
CLAMAV_PORT=3310
REQUIRE_MALWARE_SCAN=false
